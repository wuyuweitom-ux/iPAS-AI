# ========================================================
# iPAS AI 應用規劃師 (初級) 備考助教 - 環境變數範例
# ========================================================

# 1. Google Gemini API 金鑰 (必填)
# 請至 Google AI Studio (https://aistudio.google.com/) 免費申請 API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. 伺服器連接埠 (選填，預設為 3000)
PORT=3000

# 3. 部署應用程式網址 (AI Studio 或雲端環境會自動注入)
APP_URL="http://localhost:3000"

# 4. 開發環境模式
NODE_ENV="development"
